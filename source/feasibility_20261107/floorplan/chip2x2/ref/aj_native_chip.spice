** sch_path: xor_matched_tb.sch
**.subckt xor_matched_tb
XDUT bit_a bit_b reset hold_in pad vdd vss obs_sel0 obs_sel1 ref_reset obs_sel2 ext_en1 ext_en2 ext_bias uo_out0 uo_out1 uo_out2
+ uo_out3 uo_out4 uo_out5 uo_out6 uo_out7 pad2 obs2_sel0 obs2_sel1 xor_chip_staged CORE_MATCH=1 READ_MATCH=1
VA bit_a 0 PWL(0 0 0.00061249 0 0.00061251 {VDD} 0.00118249 {VDD} 0.00118251 0 0.00175249 0 0.00175251 {VDD})
VB bit_b 0 PWL(0 {VDD} 0.00118249 {VDD} 0.00118251 0)
VRESET reset 0 PWL(0 {VDD} 5.499e-05 {VDD} 5.501e-05 0 0.00060999 0 0.00061001 {VDD} 0.00062499 {VDD} 0.00062501 0 0.00117999 0 0.00118001
+ {VDD} 0.00119499 {VDD} 0.00119501 0 0.00174999 0 0.00175001 {VDD} 0.00176499 {VDD} 0.00176501 0)
VHOLD hold_in 0 PWL(0 {VDD} 5.999e-05 {VDD} 6.001e-05 0 0.00060999 0 0.00061001 {VDD} 0.00062999 {VDD} 0.00063001 0 0.00117999 0 0.00118001
+ {VDD} 0.00119999 {VDD} 0.00120001 0 0.00174999 0 0.00175001 {VDD} 0.00176999 {VDD} 0.00177001 0)
VDD_SRC vdd 0 PWL(0 0 5u {VDD})
VGND vss 0 0
RPAD pad out 60
CPAD pad 0 5p
CLOAD out 0 15p
RLOAD out 0 10Meg
VREFRESET ref_reset 0 PWL(0 {VDD} 2.499e-05 {VDD} 2.501e-05 0 0.00060999 0 0.00061001 {VDD} 0.00061499 {VDD} 0.00061501 0 0.00117999
+ 0 0.00118001 {VDD} 0.00118499 {VDD} 0.00118501 0 0.00174999 0 0.00175001 {VDD} 0.00175499 {VDD} 0.00175501 0)
C_EXT_PAD ext_bias 0 5p
R_EXT_PAD ext_bias ext_board 500
R_EXT_PULL ext_board 0 10Meg
**** begin user architecture code
.lib $PDK_ROOT/sky130A/libs.tech/ngspice/sky130.lib.spice tt
.param VDD=1.8 VREF={VDD/2} VUNIT={VDD/18}
.param TAU_R=6.5Meg STATE_C=6.5p CORE_SCALE=1 MODEL_TAU=43.5u OBS_SEL0=0 OBS_SEL1=0 TSTEP=100n
.param OBS_SEL2=0 EXT_EN1=0 EXT_EN2=0 UO_LOAD=0.2p
.param ACT_SLOPE=11.5 ACT_LIMIT=0.99

.include $PDK_ROOT/sky130A/libs.ref/sky130_fd_sc_hd/spice/sky130_fd_sc_hd.spice
* Independent ideal ODE observer: no connection drives any DUT analog node.
V_IDEAL_REF ideal_ref 0 {VREF}
V_NOMINAL nominal_vdd 0 {VDD}
B_IA ideal_a 0 V={VREF+VUNIT*(v(bit_a)>VDD/2)}
B_IB ideal_b 0 V={VREF+VUNIT*(v(bit_b)>VDD/2)}
B_IN1 ideal_n1 0 V={VREF+min(VUNIT,max(-VUNIT,8*(v(ideal_h1)-VREF)))}
B_IN2 ideal_n2 0 V={VREF-min(VUNIT,max(-VUNIT,8*(v(ideal_h2)-VREF)))}
B_IF1 ideal_f1 0 V={v(reset)>VDD/2 ? VREF : v(ideal_n1)}
B_IF2 ideal_f2 0 V={v(reset)>VDD/2 ? VREF : v(ideal_n2)}
B_IZ ideal_z 0 V={v(reset)>VDD/2 ? VREF : v(ideal_hz)}
B_ID1 ideal_d1 0 V={VREF+(v(ideal_a)-VREF)+(v(ideal_b)-VREF)+0.5*(v(ideal_z)-VREF)-0.75*VUNIT}
B_ID2 ideal_d2 0 V={VREF+(v(ideal_a)-VREF)+(v(ideal_b)-VREF)+0.5*(v(ideal_z)-VREF)-1.75*VUNIT}
B_IDZ ideal_dz 0 V={VREF+0.5*(v(ideal_f1)-VREF)+0.5*(v(ideal_f2)-VREF)}
R_I1 ideal_d1 ideal_h1 100k
R_I2 ideal_d2 ideal_h2 100k
R_IZ ideal_dz ideal_hz 100k
C_I1 ideal_h1 ideal_ref {MODEL_TAU/100k}
C_I2 ideal_h2 ideal_ref {MODEL_TAU/100k}
C_IZ ideal_hz ideal_ref {MODEL_TAU/100k}
B_IHOLD ideal_hold 0 V={(v(reset)>VDD/2 || v(hold_in)>VDD/2) ? VDD : 0}
S_I1 ideal_h1 ideal_ref ideal_hold 0 IDEAL_RESET
S_I2 ideal_h2 ideal_ref ideal_hold 0 IDEAL_RESET
S_IZ ideal_hz ideal_ref ideal_hold 0 IDEAL_RESET
.model IDEAL_RESET sw(Ron=0.01 Roff=1e15 Vt=0.9 Vh=0)
* Second ideal ODE observer: the same network with the lean activation's smooth curve (instruments only).
B_JN1 lean_n1 0 V={VREF+ACT_LIMIT*VUNIT*tanh(ACT_SLOPE*(v(lean_h1)-VREF)/(ACT_LIMIT*VUNIT))}
B_JN2 lean_n2 0 V={VREF-ACT_LIMIT*VUNIT*tanh(ACT_SLOPE*(v(lean_h2)-VREF)/(ACT_LIMIT*VUNIT))}
B_JF1 lean_f1 0 V={v(reset)>VDD/2 ? VREF : v(lean_n1)}
B_JF2 lean_f2 0 V={v(reset)>VDD/2 ? VREF : v(lean_n2)}
B_JZ lean_z 0 V={v(reset)>VDD/2 ? VREF : v(lean_hz)}
B_JD1 lean_d1 0 V={VREF+(v(ideal_a)-VREF)+(v(ideal_b)-VREF)+0.5*(v(lean_z)-VREF)-0.75*VUNIT}
B_JD2 lean_d2 0 V={VREF+(v(ideal_a)-VREF)+(v(ideal_b)-VREF)+0.5*(v(lean_z)-VREF)-1.75*VUNIT}
B_JDZ lean_dz 0 V={VREF+0.5*(v(lean_f1)-VREF)+0.5*(v(lean_f2)-VREF)}
R_J1 lean_d1 lean_h1 100k
R_J2 lean_d2 lean_h2 100k
R_JZ lean_dz lean_hz 100k
C_J1 lean_h1 ideal_ref {MODEL_TAU/100k}
C_J2 lean_h2 ideal_ref {MODEL_TAU/100k}
C_JZ lean_hz ideal_ref {MODEL_TAU/100k}
S_J1 lean_h1 ideal_ref ideal_hold 0 IDEAL_RESET
S_J2 lean_h2 ideal_ref ideal_hold 0 IDEAL_RESET
S_JZ lean_hz ideal_ref ideal_hold 0 IDEAL_RESET
B_EXPECT expected_level 0 V={VREF+VUNIT*((v(bit_a)>VDD/2)!=(v(bit_b)>VDD/2))}
V_READ read_valid 0 PWL(0 0 0.000559999 0 0.000560001 1 0.000609999 1 0.000610001 0 0.001129999 0 0.001130001 1 0.001179999 1 0.001180001 0 0.001699999 0 0.001700001 1 0.001749999 1 0.001750001 0 0.002269999 0 0.002270001 1 0.002319999 1 0.002320001 0)

.options reltol=1e-5 abstol=1e-13 vntol=1e-8 method=gear maxord=2
.options pivrel=0.1
.save v(ref_reset) v(xdut.xnet.h1) v(xdut.xnet.h2) v(xdut.xnet.hz) v(xdut.xnet.f1) v(xdut.xnet.f2) v(xdut.xnet.z) v(xdut.xnet.natural1) v(xdut.xnet.natural2) v(out) v(pad) v(out2) v(pad2) v(obs2_sel0) v(obs2_sel1) v(xdut.ref) v(xdut.vbn) v(xdut.xref.xlb.vr) v(xdut.bias1) v(xdut.bias2) v(vdd) v(bit_a) v(bit_b) v(reset) v(hold_in) v(read_valid) v(nominal_vdd) v(ideal_ref) v(expected_level) v(ideal_h1) v(ideal_h2) v(ideal_hz) v(ideal_f1) v(ideal_f2) v(lean_h1) v(lean_h2) v(lean_hz) v(lean_n1) v(lean_n2) v(ideal_n1) v(ideal_n2) v(xdut.xnet.xh1.m) v(xdut.xnet.xh1.o) v(xdut.xnet.xh2.m) v(xdut.xnet.xh2.o) v(xdut.xnet.xz.m) v(xdut.xnet.xz.o) v(xdut.xnet.xh1.az) v(xdut.xnet.xh1.xu3.nul) i(VDD_SRC) v(xdut.xnet.xh1.p) v(xdut.xnet.xh1.q) v(xdut.xnet.xh1.cmd) v(xdut.xnet.xh1.xu1.nul) v(xdut.xnet.xh1.xu3.nul) v(xdut.xnet.xh2.p) v(xdut.xnet.xh2.q) v(xdut.xnet.xh2.cmd) v(xdut.xnet.xh2.xu1.nul) v(xdut.xnet.xh2.xu3.nul) v(xdut.xnet.xz.p) v(xdut.xnet.xz.q) v(xdut.xnet.xz.cmd) v(xdut.xnet.xz.xu1.nul) v(xdut.xnet.xz.xu3.nul) v(xdut.xnet.xact1.o1p) v(xdut.xnet.xact1.o1n) v(xdut.xnet.xact2.o1p) v(xdut.xnet.xact2.o1n) v(xdut.xnet.xact1.pm) v(xdut.xnet.xact2.pm) v(obs_sel2) v(ext_en1) v(ext_en2) v(ext_bias) v(ext_board) v(xdut.sel1_ladder) v(xdut.bias1_in) v(xdut.sel2_ladder) v(xdut.bias2_in) v(uo_out0) v(uo_out1) v(uo_out2) v(uo_out3) v(uo_out4) v(uo_out5) v(uo_out6) v(uo_out7)
.tran {TSTEP} 0.00231996 0 {TSTEP}
.control
set noaskquit
set wr_vecnames
set wr_singlescale
set numdgt=16
run
let A_logic = v(bit_a)/v(nominal_vdd)
let B_logic = v(bit_b)/v(nominal_vdd)+2
let RESET_logic = v(reset)/v(nominal_vdd)+4
let HOLD_logic = v(hold_in)/v(nominal_vdd)+6
let READ_window = v(read_valid)/2-0.5
let h1_state = v(xdut.xnet.h1)-v(xdut.ref)
let h2_state = v(xdut.xnet.h2)-v(xdut.ref)
let z_state = v(xdut.xnet.hz)-v(xdut.ref)
let h1_ideal = v(ideal_h1)-v(ideal_ref)
let h2_ideal = v(ideal_h2)-v(ideal_ref)
let z_ideal = v(ideal_hz)-v(ideal_ref)
let h1_error_mV = 1000*(h1_state-h1_ideal)
let h2_error_mV = 1000*(h2_state-h2_ideal)
let z_error_mV = 1000*(z_state-z_ideal)
let H1_activation = v(xdut.xnet.f1)-v(xdut.ref)
let H2_activation = v(xdut.xnet.f2)-v(xdut.ref)
let H1_natural = v(xdut.xnet.natural1)-v(xdut.ref)
let H2_natural = v(xdut.xnet.natural2)-v(xdut.ref)
let H1_act_ideal = v(ideal_f1)-v(ideal_ref)
let H2_act_ideal = v(ideal_f2)-v(ideal_ref)
let output_measured = v(out)-v(xdut.ref)
let expected_bit = v(expected_level)-v(ideal_ref)
let read_marker = v(read_valid)*0.1
let ref_error_mV = 1000*(v(xdut.ref)-v(vdd)/2)
let bias1_error_mV = 1000*(v(xdut.bias1)-v(xdut.ref)-((v(bit_a) gt v(vdd)/2)+(v(bit_b) gt v(vdd)/2)-.75)*v(vdd)/18)
let bias2_error_mV = 1000*(v(xdut.bias2)-v(xdut.ref)-((v(bit_a) gt v(vdd)/2)+(v(bit_b) gt v(vdd)/2)-1.75)*v(vdd)/18)
let unit = v(nominal_vdd)/18
* free = 1 while the network runs free. The 10 percent threshold closes this window before the reset
* logic of the chip (it switches near half the supply) starts to clear the states, so the error plots
* show no spike at a reset edge. No apostrophes in these comments: one makes Xschem wrap the netlist lines after it.
let free = (1-(v(reset) gt v(nominal_vdd)/10))*(1-(v(hold_in) gt v(nominal_vdd)/10))
let H1 = (v(xdut.xnet.h1)-v(xdut.ref))/unit
let H2 = (v(xdut.xnet.h2)-v(xdut.ref))/unit
let Z = (v(xdut.xnet.hz)-v(xdut.ref))/unit
let H1_clip = (v(ideal_h1)-v(ideal_ref))/unit
let H2_clip = (v(ideal_h2)-v(ideal_ref))/unit
let Z_clip = (v(ideal_hz)-v(ideal_ref))/unit
let H1_lean = (v(lean_h1)-v(ideal_ref))/unit
let H2_lean = (v(lean_h2)-v(ideal_ref))/unit
let Z_lean = (v(lean_hz)-v(ideal_ref))/unit
let F1 = (v(xdut.xnet.natural1)-v(xdut.ref))/unit
let F2 = (v(xdut.xnet.natural2)-v(xdut.ref))/unit
let F1_clip = (v(ideal_n1)-v(ideal_ref))/unit
let F2_clip = (v(ideal_n2)-v(ideal_ref))/unit
let F1_lean = (v(lean_n1)-v(ideal_ref))/unit
let F2_lean = (v(lean_n2)-v(ideal_ref))/unit
let pad_out = (v(out)-v(xdut.ref))/unit
let expected_out = (v(expected_level)-v(ideal_ref))/unit
let H1_minus_lean = free*(H1-H1_lean)
let H2_minus_lean = free*(H2-H2_lean)
let Z_minus_lean = free*(Z-Z_lean)
let H1_minus_clip = free*(H1-H1_clip)
let H2_minus_clip = free*(H2-H2_clip)
let Z_minus_clip = free*(Z-Z_clip)
let A_in = v(bit_a)/v(nominal_vdd)
let B_in = v(bit_b)/v(nominal_vdd)
let RESET_in = v(reset)/v(nominal_vdd)
let HOLD_in = v(hold_in)/v(nominal_vdd)
let READ_mark = v(read_valid)
write xor_matched_tb.raw
wrdata xor_matched_tb.dat v(ref_reset) v(xdut.xnet.h1) v(xdut.xnet.h2) v(xdut.xnet.hz) v(xdut.xnet.f1) v(xdut.xnet.f2) v(xdut.xnet.z) v(xdut.xnet.natural1) v(xdut.xnet.natural2) v(out) v(pad) v(out2) v(pad2) v(obs2_sel0) v(obs2_sel1) v(xdut.ref) v(xdut.vbn) v(xdut.xref.xlb.vr) v(xdut.bias1) v(xdut.bias2) v(vdd) v(bit_a) v(bit_b) v(reset) v(hold_in) v(read_valid) v(nominal_vdd) v(ideal_ref) v(expected_level) v(ideal_h1) v(ideal_h2) v(ideal_hz) v(ideal_f1) v(ideal_f2) v(lean_h1) v(lean_h2) v(lean_hz) v(lean_n1) v(lean_n2) v(ideal_n1) v(ideal_n2) v(xdut.xnet.xh1.m) v(xdut.xnet.xh1.o) v(xdut.xnet.xh2.m) v(xdut.xnet.xh2.o) v(xdut.xnet.xz.m) v(xdut.xnet.xz.o) v(xdut.xnet.xh1.az) v(xdut.xnet.xh1.xu3.nul) i(VDD_SRC) v(xdut.xnet.xh1.p) v(xdut.xnet.xh1.q) v(xdut.xnet.xh1.cmd) v(xdut.xnet.xh1.xu1.nul) v(xdut.xnet.xh1.xu3.nul) v(xdut.xnet.xh2.p) v(xdut.xnet.xh2.q) v(xdut.xnet.xh2.cmd) v(xdut.xnet.xh2.xu1.nul) v(xdut.xnet.xh2.xu3.nul) v(xdut.xnet.xz.p) v(xdut.xnet.xz.q) v(xdut.xnet.xz.cmd) v(xdut.xnet.xz.xu1.nul) v(xdut.xnet.xz.xu3.nul) v(xdut.xnet.xact1.o1p) v(xdut.xnet.xact1.o1n) v(xdut.xnet.xact2.o1p) v(xdut.xnet.xact2.o1n) v(xdut.xnet.xact1.pm) v(xdut.xnet.xact2.pm) v(obs_sel2) v(ext_en1) v(ext_en2) v(ext_bias) v(ext_board) v(xdut.sel1_ladder) v(xdut.bias1_in) v(xdut.sel2_ladder) v(xdut.bias2_in) v(uo_out0) v(uo_out1) v(uo_out2) v(uo_out3) v(uo_out4) v(uo_out5) v(uo_out6) v(uo_out7)
echo DEMO_COMPLETE
quit
.endc

V_OBS0 obs_sel0 0 {VDD*OBS_SEL0}
V_OBS1 obs_sel1 0 {VDD*OBS_SEL1}

* Variant AI test pins, all off: SEL2=0, EXT_BIAS1=EXT_BIAS2=0.
V_OBS2 obs_sel2 0 {VDD*OBS_SEL2}
V_EXTEN1 ext_en1 0 {VDD*EXT_EN1}
V_EXTEN2 ext_en2 0 {VDD*EXT_EN2}
* uo_out loads: assumed 0.2 pF each (wire to the Tiny Tapeout mux and its input).
C_UO0 uo_out0 0 {UO_LOAD}
C_UO1 uo_out1 0 {UO_LOAD}
C_UO2 uo_out2 0 {UO_LOAD}
C_UO3 uo_out3 0 {UO_LOAD}
C_UO4 uo_out4 0 {UO_LOAD}
C_UO5 uo_out5 0 {UO_LOAD}
C_UO6 uo_out6 0 {UO_LOAD}
C_UO7 uo_out7 0 {UO_LOAD}

* Second analog output: its two select pins and the pad model on ua[2]
* (60 ohm switch, 5 pF pad, then a 10 Mohm, 15 pF probe). 00 = REF.
.param OBS2_SEL0=0 OBS2_SEL1=0
V_OBS2S0 obs2_sel0 0 {VDD*OBS2_SEL0}
V_OBS2S1 obs2_sel1 0 {VDD*OBS2_SEL1}
R_PAD2 pad2 out2 60
C_PAD2 pad2 0 5p
C_LOAD2 out2 0 15p
R_LOAD2 out2 0 10Meg

**** end user architecture code
**.ends

